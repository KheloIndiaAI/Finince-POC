# --- AWS ---
AWS_REGION=ap-south-1
S3_BUCKET=finance-poc-1

# Application IAM user (needs S3 + Textract). Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bedrock (Claude) ---
AWS_BEARER_TOKEN_BEDROCK=
CLAUDE_MODEL=global.anthropic.claude-sonnet-4-6

# --- Database (must match the Postgres container in the root .env) ---
# Host values for `python run.py`; docker-compose.yml overrides both for the
# container, which always reaches Postgres at postgres:5432.
DB_HOST=localhost
DB_PORT=55433
DB_NAME=ai_comparison
DB_USER=app_user
DB_PASSWORD=change_me_strong_password
